# --- Meta / Facebook Lead Ads ---
META_ACCESS_TOKEN=your_graph_api_access_token
META_VERIFY_TOKEN=make_up_any_random_string_here
META_APP_SECRET=your_meta_app_secret

# --- WhatsApp Cloud API ---
# If your WhatsApp number is on the same Meta app as your ads, you can reuse META_ACCESS_TOKEN
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
ALERT_TEMPLATE_NAME=lead_alert
CLIENT_TEMPLATE_NAME=lead_welcome
TEMPLATE_LANGUAGE=en_US

# --- Airtable ---
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Leads

# --- App behavior ---
WORKER_COUNT=5
PORT=8000
MAX_RETRIES=5
